generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  phone     String?
  password  String
  role      String   @default("USER")
  orders    Order[]
}

model MenuItem {
  id         Int         @id @default(autoincrement())
  category   String
  name       String
  desc       String?
  price      Float
  veg        Boolean
  imageUrl   String?
  calories   Int?        @default(0)
  protein    Float?      @default(0)
  addons     Addon[]     @relation("MenuAddons")
  orderItems OrderItem[]
}

model Addon {
  id         Int         @id @default(autoincrement())
  name       String
  price      Float
  calories   Int?        @default(0)
  protein    Float?      @default(0)
  menuItems  MenuItem[]  @relation("MenuAddons")
  orderItems OrderItem[] @relation("OrderItemAddons")
}

model Order {
  id              Int         @id @default(autoincrement())
  customerId      Int?
  user            User?       @relation(fields: [customerId], references: [id])
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  deliveryAddress String?
  totalAmount     Float
  status          String
  createdAt       DateTime    @default(now())
  orderItems      OrderItem[]
  payment         Payment?
  invoice         Invoice?
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  addons     Addon[]  @relation("OrderItemAddons")
}

model Payment {
  id                Int      @id @default(autoincrement())
  orderId           Int      @unique
  order             Order    @relation(fields: [orderId], references: [id])
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  status            String
  amount            Int      // amount in paise
  refunded          Boolean  @default(false)
  refundId          String?  // Razorpay refund ID
  createdAt         DateTime @default(now())
}

model Coupon {
  id            Int     @id @default(autoincrement())
  code          String  @unique
  discountType  String
  discountValue Float
  minOrderValue Float
  active        Boolean
}

model CarouselImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  active    Boolean  @default(true)
  order     Int      @default(0)
}

model Invoice {
  id          Int      @id @default(autoincrement())
  orderId     Int      @unique
  order       Order    @relation(fields: [orderId], references: [id])
  invoiceNumber String @unique
  pdfUrl      String
  b2ObjectKey String
  amount      Float
  taxAmount   Float    @default(0)
  totalAmount Float
  status      String   @default("ISSUED")
  issuedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BackupJob {
  id          Int      @id @default(autoincrement())
  type        String   @default("DATABASE")
  status      String   @default("PENDING")
  startedAt   DateTime @default(now())
  completedAt DateTime?
  objectKey   String?
  sizeBytes   Int?
  error       String?
}
