## 4. Database Schema & Entities

```mermaid
erDiagram
    USER ||--o{ ORDER : "places"
    ORDER ||--|{ ORDER_ITEM : "contains"
    ORDER ||--o| PAYMENT : "has"
    MENU_ITEM ||--o{ ORDER_ITEM : "ordered in"
    MENU_ITEM }|--|{ ADDON : "supports"
    ORDER_ITEM }|--|{ ADDON : "includes"
    COUPON
    CAROUSEL_IMAGE

    USER {
        int id PK
        string name
        string email UK
        string phone
        string password
        string_array address
        string role "USER or ADMIN"
    }

    MENU_ITEM {
        int id PK
        string category
        string name
        string description
        float price
        boolean veg
        string imageUrl
    }

    ADDON {
        int id PK
        string category
        string name
        float price
    }

    ORDER {
        int id PK
        int userId FK "nullable"
        string customerName
        string customerEmail
        string customerPhone
        string deliveryAddress
        float totalAmount
        string status
        datetime createdAt
    }

    ORDER_ITEM {
        int id PK
        int orderId FK
        int menuItemId FK
        int quantity
    }

    PAYMENT {
        int id PK
        int orderId FK UK
        string razorpayOrderId
        string razorpayPaymentId
        string razorpaySignature
        string status
        datetime createdAt
        datetime updatedAt
    }

    COUPON {
        int id PK
        string code UK
        string discountType "FLAT or PERCENTAGE"
        float discountValue
        float minOrderValue
        boolean active
    }

    CAROUSEL_IMAGE {
        int id PK
        string imageUrl
        boolean active
        int order
    }
